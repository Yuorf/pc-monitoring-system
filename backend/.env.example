APP_NAME=PC Monitoring System
DEBUG=true
# Leave DATABASE_URL empty or unset to fall back to local SQLite storage in backend/data/pc_monitoring.db.
DATABASE_URL=sqlite:///./data/pc_monitoring.db
# DATABASE_URL=postgresql://user:password@localhost:5432/db_name
DATABASE_ECHO=false
METRICS_COLLECTION_INTERVAL_SECONDS=60
METRICS_FAST_STARTUP_ENABLED=true
METRICS_FAST_STARTUP_DURATION_SECONDS=120
METRICS_FAST_STARTUP_INTERVAL_SECONDS=10
SMART_COLLECTION_INTERVAL_SECONDS=60
# Leave LIBRE_HARDWARE_MONITOR_EXE_PATH empty if the installer bundles LibreHardwareMonitor.exe inside the app directory.
LIBRE_HARDWARE_MONITOR_ENABLED=true
LIBRE_HARDWARE_MONITOR_AUTO_START=true
LIBRE_HARDWARE_MONITOR_EXE_PATH=
LIBRE_HARDWARE_MONITOR_STARTUP_WAIT_SECONDS=3
